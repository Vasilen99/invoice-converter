generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                 Int                 @id @default(autoincrement())
  name               String
  creditBalance      Int                 @default(0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  members            AccountMember[]
  creditTransactions CreditTransaction[]
  orders             Order[]
  organizations      Organization[]
}

model User {
  id                 Int                 @id @default(autoincrement())
  registration_date  DateTime            @default(now()) @db.Timestamptz(6)
  first_name         String?
  last_name          String?
  email              String?
  auth_uid           String?             @unique
  image              String?
  accountMembers     AccountMember[]
  creditTransactions CreditTransaction[]
}

model CompanyRegistryCache {
  id            Int            @id @default(autoincrement())
  bulstat       String         @unique
  legalName     String
  vatNumber     String?
  address       Json?
  rawLookupData Json?
  lastFetchedAt DateTime       @default(now())
  createdAt     DateTime       @default(now())
  contragents   Contragent[]
  organizations Organization[]
}

model AccountMember {
  id         Int         @id @default(autoincrement())
  accountId  Int
  userId     Int
  role       AccountRole @default(STAFF)
  invitedAt  DateTime    @default(now())
  acceptedAt DateTime?
  account    Account     @relation(fields: [accountId], references: [id])
  user       User        @relation(fields: [userId], references: [id])

  @@unique([accountId, userId])
}

model Organization {
  legalName           String
  bulstat             String?
  vatNumber           String?
  address             Json?
  invoiceSeriesPrefix String                @default("INV")
  nextInvoiceSeq      Int                   @default(1)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  accountId           Int
  molName             String?
  id                  Int                   @id @default(autoincrement())
  registryId          Int?
  source              CompanyLookupSource   @default(MANUAL)
  contragents         Contragent[]
  creditTransactions  CreditTransaction[]
  generatedInvoices   GeneratedInvoice[]
  account             Account               @relation(fields: [accountId], references: [id])
  registry            CompanyRegistryCache? @relation(fields: [registryId], references: [id])
  sourceDocuments     SourceDocument[]
}

model Contragent {
  bulstat        String?
  vatNumber      String?
  name           String
  address        Json?
  email          String?
  rawLookupData  Json?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  id             Int                   @id @default(autoincrement())
  organizationId Int
  registryId     Int?
  source         CompanyLookupSource   @default(MANUAL)
  molName        String?
  organization   Organization          @relation(fields: [organizationId], references: [id])
  registry       CompanyRegistryCache? @relation(fields: [registryId], references: [id])
  invoices       GeneratedInvoice[]

  @@unique([organizationId, bulstat])
  @@index([organizationId, name])
}

model SourceDocument {
  sourceType       SourceType
  originalFileUrl  String
  originalFilename String
  mimeType         String
  status           SourceDocumentStatus @default(UPLOADED)
  parsedData       Json?
  errorMessage     String?
  createdAt        DateTime             @default(now())
  id               Int                  @id @default(autoincrement())
  organizationId   Int
  uploadedByUserId Int
  generatedInvoice GeneratedInvoice?
  organization     Organization         @relation(fields: [organizationId], references: [id])
}

model GeneratedInvoice {
  invoiceSeries     String
  invoiceNumber     Int
  issueDate         DateTime
  taxEventDate      DateTime?
  currency          String             @default("BGN")
  originalCurrency  String?
  exchangeRate      Decimal?           @db.Decimal(12, 6)
  subtotal          Decimal            @db.Decimal(14, 2)
  vatAmount         Decimal            @db.Decimal(14, 2)
  totalAmount       Decimal            @db.Decimal(14, 2)
  pdfFileUrl        String?
  status            InvoiceStatus      @default(DRAFT)
  creditsCost       Int                @default(1)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  id                Int                @id @default(autoincrement())
  organizationId    Int
  sourceDocumentId  Int?               @unique
  contragentId      Int
  creditTransaction CreditTransaction?
  contragent        Contragent         @relation(fields: [contragentId], references: [id])
  organization      Organization       @relation(fields: [organizationId], references: [id])
  sourceDocument    SourceDocument?    @relation(fields: [sourceDocumentId], references: [id])
  lineItems         InvoiceLineItem[]

  @@unique([organizationId, invoiceSeries, invoiceNumber])
}

model InvoiceLineItem {
  description        String
  quantity           Decimal          @default(1) @db.Decimal(10, 2)
  unitPrice          Decimal          @db.Decimal(14, 2)
  vatRate            Decimal          @db.Decimal(5, 2)
  lineTotal          Decimal          @db.Decimal(14, 2)
  id                 Int              @id @default(autoincrement())
  generatedInvoiceId Int
  invoice            GeneratedInvoice @relation(fields: [generatedInvoiceId], references: [id])
}

model CreditPackage {
  name          String
  creditsAmount Int
  priceAmount   Decimal @db.Decimal(10, 2)
  currency      String  @default("BGN")
  isActive      Boolean @default(true)
  sortOrder     Int     @default(0)
  id            Int     @id @default(autoincrement())
  orders        Order[]
}

model Order {
  amount            Decimal            @db.Decimal(10, 2)
  currency          String
  status            OrderStatus        @default(PENDING)
  createdAt         DateTime           @default(now())
  accountId         Int
  provider          PaymentProvider
  id                Int                @id @default(autoincrement())
  packageId         Int
  creditTransaction CreditTransaction?
  account           Account            @relation(fields: [accountId], references: [id])
  package           CreditPackage      @relation(fields: [packageId], references: [id])
}

model CreditTransaction {
  type               CreditTransactionType
  amount             Int
  balanceAfter       Int
  note               String?
  createdAt          DateTime              @default(now())
  accountId          Int
  consumedByUserId   Int?
  id                 Int                   @id @default(autoincrement())
  organizationId     Int?
  orderId            Int?                  @unique
  generatedInvoiceId Int?                  @unique
  account            Account               @relation(fields: [accountId], references: [id])
  consumedByUser     User?                 @relation(fields: [consumedByUserId], references: [id])
  generatedInvoice   GeneratedInvoice?     @relation(fields: [generatedInvoiceId], references: [id])
  order              Order?                @relation(fields: [orderId], references: [id])
  organization       Organization?         @relation(fields: [organizationId], references: [id])
}

enum AccountRole {
  OWNER
  ADMIN
  STAFF
}

enum CompanyLookupSource {
  MANUAL
  NAP_API
}

enum SourceType {
  STRIPE
  WIX
  PAYPAL
  OTHER
}

enum SourceDocumentStatus {
  UPLOADED
  PARSING
  PARSED
  FAILED
  CONVERTED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  VOID
  CREDIT_NOTE
}

enum PaymentProvider {
  STRIPE
  PAYPAL
  MANUAL
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum CreditTransactionType {
  PURCHASE
  CONSUMPTION
  REFUND
  BONUS
  ADJUSTMENT
}
