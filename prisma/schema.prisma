generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountRole {
  OWNER
  ADMIN
  STAFF
}

// ---------------------------------------------------------
// CONTRAGENTS — the counterparties on each invoice.
// Fetched via NAP Bulstat lookup or entered manually.
// ---------------------------------------------------------

enum CompanyLookupSource {
  MANUAL
  NAP_API
}

model Account {
  id            Int      @id @default(autoincrement())
  name          String // e.g. "Ivanov Accounting Ltd", or just the freelancer's own name
  creditBalance Int      @default(0) // cache; source of truth is CreditTransaction
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  members            AccountMember[]
  organizations      Organization[]
  creditTransactions CreditTransaction[]
  orders             Order[]
}

model User {
  id                 Int                 @id @default(autoincrement())
  registration_date  DateTime            @default(now()) @db.Timestamptz(6)
  first_name         String?
  last_name          String?
  email              String?
  auth_uid           String?             @unique
  image              String?
  accountMembers     AccountMember[]
  creditTransactions CreditTransaction[]
}

// ---------------------------------------------------------
// COMPANY REGISTRY CACHE — shared NAP lookup cache, keyed by
// Bulstat. Both Organization (a client) and Contragent (a
// client's buyer) can point here so the same real company is
// only ever fetched from NAP once, no matter how many places
// in the app reference it. This is a cache, not a source of
// truth override — Organization/Contragent keep their own
// editable copies of name/address so a user can correct or
// diverge from the official record without a live NAP row
// forcing a change.
// ---------------------------------------------------------

model CompanyRegistryCache {
  id            Int   @id @default(autoincrement())
  bulstat       String   @unique
  legalName     String
  vatNumber     String?
  address       Json?
  rawLookupData Json? // full NAP API response
  lastFetchedAt DateTime @default(now())
  createdAt     DateTime @default(now())

  organizations Organization[]
  contragents   Contragent[]
}

// Join table: which users can access which accounts (firms), and with what role.
// An accountant's staff all sit here, under the firm's single Account.
model AccountMember {
  id         Int         @id @default(autoincrement())
  accountId  Int
  userId     Int
  role       AccountRole @default(STAFF)
  invitedAt  DateTime    @default(now())
  acceptedAt DateTime?

  account Account @relation(fields: [accountId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([accountId, userId])
}

// ---------------------------------------------------------
// ORGANIZATION — a client entity. Its Bulstat/VAT/MOL are what
// print as the seller on generated invoices. No credit balance
// here anymore — that lives on the parent Account.
// ---------------------------------------------------------

model Organization {
  id        Int @id @default(autoincrement())
  accountId Int

  legalName           String
  bulstat             String?
  vatNumber           String?
  address             Json?
  molName             String? // Материално отговорно лице — required on the invoice issuer block
  source              CompanyLookupSource   @default(MANUAL)
  registryId          Int? // link to the cached NAP lookup this was created/refreshed from
  registry            CompanyRegistryCache? @relation(fields: [registryId], references: [id])
  invoiceSeriesPrefix String                @default("INV")
  nextInvoiceSeq      Int                   @default(1) // increment inside the same tx that creates the invoice

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account            Account             @relation(fields: [accountId], references: [id])
  contragents        Contragent[]
  sourceDocuments    SourceDocument[]
  generatedInvoices  GeneratedInvoice[]
  creditTransactions CreditTransaction[] // attribution: which client a credit spend was for
}

model Contragent {
  id             Int              @id @default(autoincrement())
  organizationId Int
  bulstat        String?
  vatNumber      String?
  name           String
  address        Json?
  email          String?
  source         CompanyLookupSource @default(MANUAL)
  registryId     Int?  // link to the cached NAP lookup this was created/refreshed from
  registry       CompanyRegistryCache? @relation(fields: [registryId], references: [id])
  rawLookupData  Json? // raw NAP API response, kept for audit
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization           Organization          @relation(fields: [organizationId], references: [id])
  invoices               GeneratedInvoice[]

  @@unique([organizationId, bulstat])
  @@index([organizationId, name])
}

// ---------------------------------------------------------
// DOCUMENT PIPELINE: raw upload -> parsed data -> compliant invoice.
// ---------------------------------------------------------

enum SourceType {
  STRIPE
  WIX
  PAYPAL
  OTHER
}

enum SourceDocumentStatus {
  UPLOADED
  PARSING
  PARSED
  FAILED
  CONVERTED
}

model SourceDocument {
  id               Int                  @id @default(autoincrement())
  organizationId   Int
  uploadedByUserId Int
  sourceType       SourceType
  originalFileUrl  String // Supabase Storage path, e.g. organizations/{orgId}/source-documents/{id}
  originalFilename String
  mimeType         String
  status           SourceDocumentStatus @default(UPLOADED)
  parsedData       Json? // normalized fields extracted from the source doc
  errorMessage     String?
  createdAt        DateTime             @default(now())

  organization     Organization      @relation(fields: [organizationId], references: [id])
  generatedInvoice GeneratedInvoice?
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  VOID
  CREDIT_NOTE
}

model GeneratedInvoice {
  id               Int  @id @default(autoincrement())
  organizationId   Int
  sourceDocumentId Int? @unique
  contragentId     Int

  invoiceSeries String
  invoiceNumber Int // combine with series for the legal number; must be gapless per Organization
  issueDate     DateTime
  taxEventDate  DateTime?

  currency         String   @default("BGN")
  originalCurrency String? // if the source doc was USD/EUR
  exchangeRate     Decimal? @db.Decimal(12, 6)

  subtotal    Decimal @db.Decimal(14, 2)
  vatAmount   Decimal @db.Decimal(14, 2)
  totalAmount Decimal @db.Decimal(14, 2)

  pdfFileUrl  String? // Supabase Storage path
  status      InvoiceStatus @default(DRAFT)
  creditsCost Int           @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization      Organization       @relation(fields: [organizationId], references: [id])
  sourceDocument    SourceDocument?    @relation(fields: [sourceDocumentId], references: [id])
  contragent        Contragent         @relation(fields: [contragentId], references: [id])
  lineItems         InvoiceLineItem[]
  creditTransaction CreditTransaction?

  @@unique([organizationId, invoiceSeries, invoiceNumber])
}

model InvoiceLineItem {
  id                 Int     @id @default(autoincrement())
  generatedInvoiceId Int
  description        String
  quantity           Decimal @default(1) @db.Decimal(10, 2)
  unitPrice          Decimal @db.Decimal(14, 2)
  vatRate            Decimal @db.Decimal(5, 2)
  lineTotal          Decimal @db.Decimal(14, 2)

  invoice GeneratedInvoice @relation(fields: [generatedInvoiceId], references: [id])
}

// ---------------------------------------------------------
// CREDITS / BILLING
// CreditTransaction is the ledger (source of truth), owned by
// Account. Organization is attribution only (which client the
// spend was for); consumedByUser is attribution too (which
// staff member triggered it).
// ---------------------------------------------------------

model CreditPackage {
  id            Int     @id @default(autoincrement())
  name          String
  creditsAmount Int
  priceAmount   Decimal @db.Decimal(10, 2)
  currency      String  @default("BGN")
  isActive      Boolean @default(true)
  sortOrder     Int     @default(0)

  orders Order[]
}

enum PaymentProvider {
  STRIPE
  PAYPAL
  MANUAL
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Order {
  id        Int             @id @default(autoincrement())
  accountId Int
  packageId Int
  amount    Decimal         @db.Decimal(10, 2)
  currency  String
  provider  PaymentProvider
  status    OrderStatus     @default(PENDING)
  createdAt DateTime        @default(now())

  account           Account            @relation(fields: [accountId], references: [id])
  package           CreditPackage      @relation(fields: [packageId], references: [id])
  creditTransaction CreditTransaction?
}

enum CreditTransactionType {
  PURCHASE
  CONSUMPTION
  REFUND
  BONUS
  ADJUSTMENT
}

model CreditTransaction {
  id                 Int                   @id @default(autoincrement())
  accountId          Int // whose wallet this debits/credits — the firm
  organizationId     Int? // attribution: which client this spend was for (null for pure purchases)
  type               CreditTransactionType
  amount             Int // positive for credit in, negative for consumption
  balanceAfter       Int
  orderId            Int?                  @unique
  generatedInvoiceId Int?                  @unique
  consumedByUserId   Int? // attribution: which staff member triggered it
  note               String?
  createdAt          DateTime              @default(now())

  account          Account           @relation(fields: [accountId], references: [id])
  organization     Organization?     @relation(fields: [organizationId], references: [id])
  order            Order?            @relation(fields: [orderId], references: [id])
  generatedInvoice GeneratedInvoice? @relation(fields: [generatedInvoiceId], references: [id])
  consumedByUser   User?             @relation(fields: [consumedByUserId], references: [id])
}
